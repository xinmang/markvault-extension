{
  "name": "markvault-extension",
  "version": "0.0.4",
  "description": "MarkVault 智能书签管理浏览器扩展 - 支持 AI 标签推荐、标签页组管理和 Chromium 浏览器",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-multi-browser.mjs",
    "build:legacy": "node scripts/build-and-pack.mjs",
    "build:only": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:chrome": "node scripts/build-multi-browser.mjs chrome",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs"
  },
  "keywords": [],
  "author": "MarkVault Team",
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "commonjs",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^5.2.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.6.1",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.554.0",
    "lunar-javascript": "^1.7.7",
    "openai": "^6.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinmang/markvault-extension.git"
